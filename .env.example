# Copy to .env (git-ignored) and fill in. Vite exposes only VITE_*-prefixed vars
# to the browser.
#
# This is a static site, so anything here ships to the visitor and is inherently
# public. These vars exist for rotation and hygiene, not secrecy — config.js
# carries working defaults if they are unset.

# Google Apps Script Web App URL (Deploy > Web app URL).
VITE_APPS_SCRIPT_URL=""

# The "Family Trips" master folder ID, from the Drive URL:
# https://drive.google.com/drive/folders/<FOLDER_ID>
VITE_MASTER_FOLDER_ID=""
