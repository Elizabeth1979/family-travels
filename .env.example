# Copy to .env (git-ignored) and fill in. Vite exposes only VITE_*-prefixed vars
# to the browser.

# --- Frontend (public; safe to ship) -----------------------------------------
# The publishable key grants no data access by itself — Row-Level Security on
# albums/photos decides what anonymous visitors can read. Defaults for the
# family-travels project are baked into supabaseClient.js; set these only to
# point a build at a different Supabase project.
VITE_SUPABASE_URL="https://vsxbedlsnfmsbnlfayae.supabase.co"
VITE_SUPABASE_KEY="sb_publishable_G8aIBjhnmrVHVzIeYkIynQ_MbrIw7hn"

# Legacy Google backend, still serving production until the Phase 1 cutover.
VITE_APPS_SCRIPT_URL=""
VITE_MASTER_FOLDER_ID=""

# --- One-time import script (local only; NEVER commit or ship) ---------------
# Used by: node scripts/import-from-apps-script.mjs
# The service-role key bypasses Row-Level Security, which is why the import can
# insert rows on the owner's behalf. Treat it like a password: shell/local .env
# only, never in client code, never in a Vercel *public* env var.
SUPABASE_URL="https://vsxbedlsnfmsbnlfayae.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# UUID of the auth.users row that should own the imported albums. Create the
# user first in Supabase → Authentication → Users; this is also the login for
# the Phase 3 admin panel.
OWNER_ID=""
